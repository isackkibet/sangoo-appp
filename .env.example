# Neon Postgres (server-side only)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the redirect URI must be explicit:
# GOOGLE_REDIRECT_URI=https://<your-domain>/api/auth/google/callback

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (photo + video uploads)
# The bucket is created automatically as a public bucket on first upload.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Protects the story cleanup cron endpoint (/api/cron/stories).
# Vercel Cron sends this automatically as a Bearer token when set.
CRON_SECRET=

# AI providers (server-side only).
# Groq is the default provider. Set GROQ_API_KEY on Vercel and the app will
# use Groq even without the Supabase settings table.
GROQ_API_KEY=
# Available models on Groq include openai/gpt-oss-120b and openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: force a provider: groq | openai | gemini | anthropic
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Required only when saving keys from the admin dashboard.
AI_SETTINGS_SECRET=
# Required for admin-only actions such as saving AI keys.
SIHU_ADMIN_KEY=

# Optional shared cache (Upstash Redis REST).
# Without these, the app uses a fast in-memory cache per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
